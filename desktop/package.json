{
  "name": "pomodoro-desktop",
  "productName": "Pomodoro",
  "version": "2.0.0",
  "description": "Pomodoro focus timer with tasks, reports and music",
  "author": "nepaliapil",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node copy-web.js && electron .",
    "dist": "node copy-web.js && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nepaliapil.pomodoro",
    "productName": "Pomodoro",
    "files": [
      "main.js",
      "web/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pomodoro",
      "artifactName": "Pomodoro-Setup-${version}.exe"
    }
  }
}
